{
  "name": "backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --hot src/index.tsx",
    "watch:css": "tailwindcss -i src/style.css -o src/public/style.css --watch",
    "watch:js": "bun build src/frontend.ts --outdir src/public --watch",
    "build:css": "tailwindcss -i src/style.css -o src/public/style.css",
    "build:js": "bun build src/frontend.ts --outdir src/public --minify",
    "build": "bun run build:css && bun run build:js",
    "source-hash": "bun run scripts/source-hash.ts",
    "prepare": "cd .. && husky backend/.husky || true"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@types/bun": "^1.3.13",
    "gltf-validator": "2.0.0-dev.3.10",
    "husky": "^9.1.7",
    "tailwindcss": "^4.3.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@gltf-transform/core": "4.5.1",
    "alpinejs": "^3.15.12",
    "fengari": "^0.1.5",
    "hono": "^4.12.18",
    "htmx.org": "^2.0.10"
  }
}
